#include <ESP32Servo.h>

// ---------- Pins ----------
const int PIN_ELBOW = 18;
const int PIN_WRIST = 4;
const int PIN_BASE  = 23;

// ---------- Elbow and wrist angles ----------
// Your arm is mounted the opposite way, so "down" is now ABOVE 90 instead of below.
const int ELBOW_UP   = 90;
const int ELBOW_DOWN = 155;   // was 25. Mirrored: 90 + 65. Raise for more travel, lower for less
const int WRIST_UP   = 90;
const int WRIST_DOWN = 150;   // was 30. Mirrored: 90 + 60

// ---------- Base (MG996R) ----------
const bool BASE_IS_CONTINUOUS = true;

// Used when BASE_IS_CONTINUOUS = true
const int BASE_STOP        = 90;    // value where the base stands still (tune 88-92)
const int BASE_SPEED       = 6;     // 1-90, higher = faster
const int BASE_ROTATE_TIME = 4000;  // was 2000 (that gave ~90 degrees), so 4000 for ~180

// Used when BASE_IS_CONTINUOUS = false
const int BASE_PICKUP = 0;
const int BASE_BIN    = 180;

// ---------- Speed: ms per 1-degree step (higher = slower) ----------
const int ELBOW_STEP_DELAY = 40;
const int WRIST_STEP_DELAY = 35;
const int BASE_STEP_DELAY  = 40;    // only for standard 180-degree base

// ---------- Pauses (ms) ----------
const int PAUSE_BETWEEN_STEPS = 1000;
const int PICKUP_TIME         = 1500;
const int BIN_TIME            = 1500;
const int CYCLE_END_PAUSE     = 2000;
const int BEFORE_BASE_DELAY   = 4000;   // wait after the elbow is up, before the base turns

// ---------- Pulse widths (us) ----------
const int MG90S_MIN_US  = 500;
const int MG90S_MAX_US  = 2400;
const int MG996R_MIN_US = 500;
const int MG996R_MAX_US = 2500;

Servo elbow;
Servo wrist;
Servo base;

int elbowAngle = ELBOW_UP;
int wristAngle = WRIST_UP;
int baseAngle  = BASE_PICKUP;

// Move ONE servo slowly to a target angle
void moveSlow(Servo &s, int &current, int target, int stepDelay) {
  target = constrain(target, 0, 180);
  int dir = (target > current) ? 1 : -1;
  while (current != target) {
    current += dir;
    s.write(current);
    delay(stepDelay);
  }
}

// Rotate the base ONLY when called. direction: +1 = to the bin, -1 = back
void rotateBase(int direction) {
  base.setPeriodHertz(50);
  base.attach(PIN_BASE, MG996R_MIN_US, MG996R_MAX_US);

  if (BASE_IS_CONTINUOUS) {
    base.write(BASE_STOP + (direction * BASE_SPEED));
    delay(BASE_ROTATE_TIME);
    base.write(BASE_STOP);
    delay(300);
  } else {
    int target = (direction > 0) ? BASE_BIN : BASE_PICKUP;
    base.write(baseAngle);
    delay(200);
    moveSlow(base, baseAngle, target, BASE_STEP_DELAY);
    delay(300);
  }

  base.detach();   // no signal = the base cannot spin or creep until needed again
}

void setup() {
  Serial.begin(115200);

  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);

  // Base is NOT attached here, so it stays still at startup.

  elbow.setPeriodHertz(50);
  wrist.setPeriodHertz(50);
  elbow.attach(PIN_ELBOW, MG90S_MIN_US, MG90S_MAX_US);
  wrist.attach(PIN_WRIST, MG90S_MIN_US, MG90S_MAX_US);

  elbow.write(elbowAngle);
  wrist.write(wristAngle);
  delay(2000);

  Serial.println("Pick-and-place started.");
}

void loop() {
  // 1. Elbow comes down slowly
  Serial.println("1. Elbow down");
  moveSlow(elbow, elbowAngle, ELBOW_DOWN, ELBOW_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);

  // 2. Wrist comes down (picks up the metal)
  Serial.println("2. Wrist down - picking up");
  moveSlow(wrist, wristAngle, WRIST_DOWN, WRIST_STEP_DELAY);
  delay(PICKUP_TIME);

  // 3. Wrist comes up
  Serial.println("3. Wrist up");
  moveSlow(wrist, wristAngle, WRIST_UP, WRIST_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);

  // 4. Elbow comes up
  Serial.println("4. Elbow up");
  moveSlow(elbow, elbowAngle, ELBOW_UP, ELBOW_STEP_DELAY);
  delay(BEFORE_BASE_DELAY);

  // 5. ONLY NOW the base turns 180 degrees to the bin
  Serial.println("5. Base rotating 180 degrees to the bin");
  rotateBase(+1);
  delay(BIN_TIME);

  // 6. Base turns back to the pickup position
  Serial.println("6. Base returning to pickup");
  rotateBase(-1);
  delay(CYCLE_END_PAUSE);
}
