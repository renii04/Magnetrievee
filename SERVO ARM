/* 
  Pick-and-place arm (ESP32 Version) 
  - Servo 1: MG90S (ELBOW) - GPIO 18
  - Servo 2: MG90S (WRIST) - GPIO 4
  - Servo 3: MG996R (BASE) - GPIO 23 
  
  POWER NOTE FOR ESP32: The ESP32 runs on 3.3V logic, but your servos still need an external 5-6V supply. 
  Ensure your external power supply Ground (GND) is connected to the ESP32 GND pin. ,
*/

#include <ESP32Servo.h> 

// ---------- Pins (ESP32 Safe GPIOs) ----------
const int PIN_ELBOW = 18;
const int PIN_WRIST = 4;
const int PIN_BASE = 23;

// ---------- Angles ----------
const int ELBOW_UP = 90;
const int ELBOW_DOWN = 40;
const int WRIST_UP = 90;
const int WRIST_DOWN = 30;

// Base rotates exactly 180 degrees from pickup to drop
// NOTE: If your MG996R cannot mechanically reach 210, change PICKUP to 0 and DROP to 180.
const int BASE_PICKUP = 30; 
const int BASE_DROP = 210; // 30 + 180 = 210 degrees

// ---------- Speed ----------
const int ELBOW_STEP_DELAY = 30;
const int WRIST_STEP_DELAY = 30;
const int BASE_STEP_DELAY = 40;

// ---------- Pauses between steps (ms) ----------
const int PAUSE_BETWEEN_STEPS = 800;
const int PICKUP_TIME = 1500;
const int DROP_TIME = 1500;

// ---------- Pulse widths (us) ----------
const int MG90S_MIN_US = 500;
const int MG90S_MAX_US = 2400;
const int MG996R_MIN_US = 500;
const int MG996R_MAX_US = 2500;

Servo elbow;
Servo wrist;
Servo base;

int elbowAngle = 90;
int wristAngle = 90;
int baseAngle = 90;

// Move ONE servo slowly to a target angle.
void moveSlow(Servo &s, int &current, int target, int stepDelay) {
  target = constrain(target, 0, 240); // Increased limit to support extended range servos
  int dir = (target > current) ? 1 : -1;
  while (current != target) {
    current += dir;
    s.write(current);
    delay(stepDelay);
  }
}

void setup() {
  Serial.begin(115200);
  
  // Explicitly allocate separate hardware timers to prevent cross-servo interference
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  
  elbow.setPeriodHertz(50);
  wrist.setPeriodHertz(50);
  base.setPeriodHertz(50);
  
  // Attach servos with specific pulse ranges
  elbow.attach(PIN_ELBOW, MG90S_MIN_US, MG90S_MAX_US);
  wrist.attach(PIN_WRIST, MG90S_MIN_US, MG90S_MAX_US);
  base.attach(PIN_BASE, MG996R_MIN_US, MG996R_MAX_US);

  // Initialize tracking and move to safe starting positions immediately
  elbow.write(elbowAngle);
  wrist.write(wristAngle);
  base.write(baseAngle);
  delay(1000);

  Serial.println("Moving slowly to home position...");
  moveSlow(elbow, elbowAngle, ELBOW_UP, ELBOW_STEP_DELAY);
  moveSlow(wrist, wristAngle, WRIST_UP, WRIST_STEP_DELAY);
  moveSlow(base, baseAngle, BASE_PICKUP, BASE_STEP_DELAY);
  delay(1000);
  
  Serial.println("ESP32 Pick-and-place started.");
}

void loop() {
  // --- PICKUP PHASE ---
  Serial.println("1. Elbow down");
  moveSlow(elbow, elbowAngle, ELBOW_DOWN, ELBOW_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);
  
  Serial.println("2. Wrist down - picking up");
  moveSlow(wrist, wristAngle, WRIST_DOWN, WRIST_STEP_DELAY);
  delay(PICKUP_TIME);
  
  Serial.println("3. Wrist up");
  moveSlow(wrist, wristAngle, WRIST_UP, WRIST_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);
  
  Serial.println("4. Elbow up");
  moveSlow(elbow, elbowAngle, ELBOW_UP, ELBOW_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);

  // --- TRANSIT TO DROP (180 Degree Rotation) ---
  Serial.println("5. Base rotating 180 degrees to drop spot"); //PALITAN NIYO NG 360 IF HINDI GANITO YUNG CONCEPT
  moveSlow(base, baseAngle, BASE_DROP, BASE_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);

  // --- DROP PHASE ---
  Serial.println("6. Elbow down at drop spot");
  moveSlow(elbow, elbowAngle, ELBOW_DOWN, ELBOW_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);
  
  Serial.println("7. Wrist down - dropping");
  moveSlow(wrist, wristAngle, WRIST_DOWN, WRIST_STEP_DELAY);
  delay(DROP_TIME);
  
  Serial.println("8. Wrist up");
  moveSlow(wrist, wristAngle, WRIST_UP, WRIST_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);
  
  Serial.println("9. Elbow up");
  moveSlow(elbow, elbowAngle, ELBOW_UP, ELBOW_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS);

  // --- RETURN HOME ---
  Serial.println("10. Base rotating back to pickup");
  moveSlow(base, baseAngle, BASE_PICKUP, BASE_STEP_DELAY);
  delay(PAUSE_BETWEEN_STEPS * 2);
}
