const int SOLENOID_PIN = 21;

const int SOLENOID_ON_LEVEL  = LOW;
const int SOLENOID_OFF_LEVEL = HIGH;

void setup() {
  Serial.begin(115200);

  digitalWrite(SOLENOID_PIN, SOLENOID_OFF_LEVEL);
  pinMode(SOLENOID_PIN, OUTPUT);
  digitalWrite(SOLENOID_PIN, SOLENOID_OFF_LEVEL);
3
  Serial.println("Magnetrieve Manual Control Ready!");
  Serial.println("Type '1' or 'ON' to turn Solenoid ON");
  Serial.println("Type '0' or 'OFF' to turn Solenoid OFF");
}

void loop() {
  if (Serial.available() > 0) {
    String command = Serial.readStringUntil('\n');
    command.trim();
    command.toUpperCase();

    if (command == "1" || command == "ON") {
      digitalWrite(SOLENOID_PIN, SOLENOID_ON_LEVEL);
      Serial.println("--> [COMMAND RECEIVED] Solenoid: ON");
    }
    else if (command == "0" || command == "OFF") {
      digitalWrite(SOLENOID_PIN, SOLENOID_OFF_LEVEL);
      Serial.println("--> [COMMAND RECEIVED] Solenoid: OFF");
    }
    else {
      Serial.print("--> Invalid Command: '");
      Serial.print(command);
      Serial.println("'. Please type '1', '0', 'ON', or 'OFF'.");
    }
  }
}
